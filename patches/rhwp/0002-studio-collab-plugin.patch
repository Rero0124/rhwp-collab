+        : readSteps(t.path);
+      return steps ? cellPosition(t.sec, t.parentPara, 0, steps) : null;
+    },
+    set(p) {
+      if (t.kind === 'body') {
+        t.para = p.para;
+        return;
+      }
+      const steps = stepsOf(p);
+      t.parentPara = p.para;
+      if (t.kind === 'cell') t.cellParaIdx = steps[0]?.cellPara ?? t.cellParaIdx;
+      else if (Array.isArray(t.path) && t.path.length === steps.length) t.path = writeSteps(t.path as Rec[], steps);
+    },
+  }));
+}
+
+/** 양식 값 대상: 본문이면 (sec, para), 셀이면 `inCell` 의 (표 문단, 표 개체, 칸, 칸 문단). */
+function formTarget(t: Rec): CollabUndoSlot | null {
+  const inCell = t.inCell as Rec | undefined;
+  if (!inCell) return secPara(t, 'sec', 'para');
+  return {
+    key: inCell,
+    field: 'cell',
+    get() {
+      const steps = readSteps([{ controlIndex: inCell.tableCi, cellIndex: inCell.cellIdx, cellParaIndex: inCell.cellPara }]);
+      return isNum(t.sec) && isNum(inCell.tablePara) && steps ? cellPosition(t.sec, inCell.tablePara, 0, steps) : null;
+    },
+    set(p) {
+      inCell.tablePara = p.para;
+      inCell.cellPara = stepsOf(p)[0]?.cellPara ?? inCell.cellPara;
+    },
+  };
