+// ── 표 대조 (drift) ──────────────────────────────────────────────────
+
+const commandSrc = source('src/engine/command.ts');
+/** command.ts 의 명령 클래스 → 본문 */
+const commandClasses = (() => {
+  const out = new Map<string, string>();
+  const re = /export class (\w+)(?: extends SnapshotCommand| implements EditCommand)\b/g;
+  for (let m = re.exec(commandSrc); m; m = re.exec(commandSrc)) out.set(m[1], balancedFrom(commandSrc.slice(m.index), `class ${m[1]}`, '{'));
+  return out;
+})();
