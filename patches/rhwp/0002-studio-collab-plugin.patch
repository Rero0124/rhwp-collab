+test('InputHandler: 중지 중 undo/redo 는 안내만, 조합 종료 이벤트, 캐럿 이동은 선택을 접는다', () => {
+  const ih = source('src/engine/input-handler.ts');
+  for (const fn of ['private handleUndo(): void {', 'private handleRedo(): void {']) {
+    const body = ih.slice(ih.indexOf(fn), ih.indexOf(fn) + 300);
+    assert.match(body, /if \(this\.historySuspendedMessage !== null\) \{\s*showToast\(\{ message: this\.historySuspendedMessage \}\);\s*return;/, fn);
