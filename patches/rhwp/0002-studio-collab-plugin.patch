diff --git a/rhwp-studio/src/engine/collab-undo.ts b/rhwp-studio/src/engine/collab-undo.ts
new file mode 100644
index 00000000..4f8a8fe5
--- /dev/null
+++ b/rhwp-studio/src/engine/collab-undo.ts
@@ -0,0 +1,476 @@
+/**
+ * cc-rhwp(4단계 U1·U2): 공동편집 중 되돌리기 — 명령이 기억한 위치의 표 (docs/collab-stage4.md §5).
+ *
+ * 공동편집 플러그인은 남의 편집이 들어올 때마다 되돌리기 스택의 위치를 옮기고, 겹치면 그 단계를 막는다.
+ * 명령은 위치를 저마다 다른 필드에 들고 있으므로(공통 타입이 없다), 여기 표가 명령 종류마다 "어느 필드가
+ * 어떤 위치인가"를 알려 준다. 표에 없는 종류(스냅샷 명령, 셀 테두리·배경, 그리고 업스트림이 나중에 더한 명령)는
+ * `null` — 플러그인이 "뒤에 남의 편집이 하나라도 있으면 막음"(3.2-3)으로 다룬다.
+ *
+ * U2 에서 넓힌 것: 중첩 셀 경로, 머리말·꼬리말(안쪽 좌표는 본문 편집과 무관 — 발자국이 구역 단위), 각주(각주를 품은
+ * 본문 문단), 개체(개체를 품은 본문 문단 또는 칸 문단), 구역 설정·z 순서(구역 원본 저널 — `store: 'section'`),
+ * 양식 값.
+ *
+ * 이 파일은 명령 클래스를 import 하지 않는다(필드 이름으로 읽고 쓴다). 업스트림이 필드 이름을 바꾸면
+ * `tests/plugin-collab-undo.test.ts` 의 대조 시험이 깨진다.
+ */
+
+/** 셀 경로 한 단계(개체, 칸, 그 칸의 문단). */
+export interface CollabUndoCellStep { control: number; cell: number; cellPara: number }
+
+/**
+ * 위치 하나(텍스트 좌표). 셀이면 `para` 는 바깥 표를 품은 본문 문단이고 `cellPath` 가 바깥 → 안쪽 단계다(마지막
+ * 단계의 `cellPara` 가 위치의 칸 문단, 그 앞 단계의 `cellPara` 는 다음 단계 표를 품은 문단). 한 단계면 `cell` 로도
+ * 준다(U1 모양).
+ */
+export interface CollabUndoPosition {
+  section: number;
+  para: number;
+  offset: number;
+  cell?: CollabUndoCellStep | null;
+  cellPath?: CollabUndoCellStep[] | null;
+  /** 문단으로 특정할 수 없는 자리(`section`) / 그 구역의 어떤 기록이든 닿는 지킴(`sectionAll`) */
+  scope?: 'section' | 'sectionAll';
+  /** 나눔 지점에서 뒤 문단으로 따라가는가(기본 after). 범위 끝은 before. */
+  bias?: 'before' | 'after';
+}
+
+/** 명령 안의 위치 한 자리. */
+export interface CollabUndoSlot {
+  /** 같은 위치 객체를 여러 자리가 가리킬 수 있다 — 플러그인이 (key, field)로 한 번만 옮긴다. */
+  readonly key: object;
+  readonly field: string;
+  /** 지금 위치. 옮길 수 없는 모양(중첩 셀·글상자·캡션)이면 `null` — 그 명령은 3.2-3. */
+  get(): CollabUndoPosition | null;
+  set(p: CollabUndoPosition): void;
+  /** 캐럿·선택 복원용 — 옮기기만 하고 막힘 판정에는 쓰지 않는다. */
+  readonly caret?: boolean;
+}
+
+/**
+ * 되돌리기가 기대는 WASM 저장소. `fragment` 는 절대 문단 번호로 복원하는 삭제 조각, `snapshot` 은 문서 전체,
+ * `section` 은 구역 원본 저널(`captureSectionRaw` ↔ `restoreSectionRaw` — 캡처와 복원 사이 그 구역 편집 금지).
+ */
+export type CollabUndoStore = 'none' | 'fragment' | 'snapshot' | 'section';
+
+export interface CollabUndoDescriptor {
+  slots: CollabUndoSlot[];
+  store: CollabUndoStore;
+  /** `store === 'fragment'`: 조각이 기억한 문단 자리. 이것이 옮겨지면(앞쪽 문단 수 변화) 되돌릴 수 없다. */
+  fragmentAnchor?: CollabUndoSlot;
+  /** `store === 'section'`: 되돌리기가 저널로 복원하는 구역들 */
+  sections?: number[];
+}
+
+/** 히스토리가 공동편집 플러그인에 알리는 훅. */
+export interface CollabHistoryHook {
+  /** 명령이 스택에 들어갔다(병합이면 `replaced` 가 이전 top). 직전 경계 뒤의 로컬 기록이 이 명령 것이다. */
+  recorded(command: object, replaced: object | null): void;
+  /** 명령을 남기지 않은 경계(no-op·실패·기록 중지) — 그 사이 로컬 기록은 어느 명령 것도 아니다. */
+  settled(): void;
+  /** 되돌리기/다시 하기 전 막힘 판정. 막히면 알림 문구. */
+  blocked(command: object, dir: 'undo' | 'redo'): string | null;
+  /** 막혀서 스택에서 버렸다(호스트가 알림을 띄운다). */
+  rejected(command: object, dir: 'undo' | 'redo', reason: string): void;
+  undone(command: object): void;
+  redone(command: object): void;
+}
+
+/** 플러그인이 쓰는 히스토리 조작. */
+export interface CollabHistoryController {
+  /** 양 스택(아래→위). 읽기 전용 사본. */
+  stacks(): { undo: readonly object[]; redo: readonly object[] };
+  /** 명령들을 스택에서 빼고 자원을 해제한다(버려진 편집, 3.3). */
+  remove(commands: ReadonlySet<object>): void;
+  /** 양 스택을 비운다(재동기화·문서 교체, 3.4). */
+  clear(): void;
+  describe(command: object): CollabUndoDescriptor | null;
+}
+
+/**
+ * 명령 클래스 → 이 표의 다룸. `table` 은 위치를 옮기고 3.2-1·2·4 로 판정, `strict` 는 3.2-3.
+ * `tests/plugin-collab-undo.test.ts` 가 `command.ts` 의 명령 클래스 목록과 대조한다(새 클래스가 생기면 실패).
+ */
+export const COLLAB_UNDO_CLASSES: Readonly<Record<string, 'table' | 'strict'>> = {
+  InsertTextCommand: 'table',
+  DeleteTextCommand: 'table',
+  InsertLineBreakCommand: 'table',
+  InsertTabCommand: 'table',
+  SplitParagraphCommand: 'table',
+  MergeParagraphCommand: 'table',
+  FragmentDeleteCommand: 'table',
+  DeleteSelectionCommand: 'table',
+  ApplyCharFormatCommand: 'table',
+  ApplyParaFormatCommand: 'table',
+  MergeNextParagraphCommand: 'table',
+  SplitParagraphInCellCommand: 'table',
+  MergeParagraphInCellCommand: 'table',
+  MergeNextParagraphInCellCommand: 'table',
+  // U2: 머리말·꼬리말·각주, 개체, 구역, 양식
+  InsertTextInHeaderFooterCommand: 'table',
+  InsertFieldInHeaderFooterCommand: 'table',
+  DeleteTextInHeaderFooterCommand: 'table',
+  SplitParagraphInHeaderFooterCommand: 'table',
+  MergeParagraphInHeaderFooterCommand: 'table',
+  InsertTextInFootnoteCommand: 'table',
+  DeleteTextInFootnoteCommand: 'table',
+  SplitParagraphInFootnoteCommand: 'table',
+  MergeParagraphInFootnoteCommand: 'table',
+  MoveTableCommand: 'table',
+  MovePictureCommand: 'table',
+  MoveShapeCommand: 'table',
+  ResizeObjectCommand: 'table',
+  MoveLineEndpointCommand: 'table',
+  SetObjectPropsCommand: 'table',
+  SetSectionPropsCommand: 'table',
+  SetZOrderCommand: 'table',
+  SetSectionPropsAllCommand: 'table',
+  SetFormValueCommand: 'table',
+  // 되돌리기가 문서 목록 꼬리를 개수로 지운다(removeBorderFillTails) — 3.2-3 (U0 결정)
+  SetCellBorderFillCommand: 'strict',
+  // 문서 전체 스냅샷으로 되돌린다 — 그사이 남의 편집까지 지우므로 언제나 3.2-3
+  SnapshotCommand: 'strict',
+  SubmodeSnapshotCommand: 'strict',
+  SubmodeSelectionSnapshotCommand: 'strict',
+};
+
+type Rec = Record<string, unknown>;
+type CellEntry = { controlIndex: number; cellIndex: number; cellParaIndex: number };
+
+const isNum = (v: unknown): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v >= 0;
+/** 캡션·글상자 가상 칸 번호(셀 경로로 쓰지만 표 칸이 아니다) */
+const VIRTUAL_CELL = 65534;
+
+/**
+ * 셀 경로 읽기. 단계 키는 `controlIndex` 계열(CellPathEntry)과 `controlIdx` 계열(CellPathSegment) 둘 다.
+ * 가상 칸(캡션·글상자)이 끼면 `null`.
+ */
+function readSteps(path: unknown): CollabUndoCellStep[] | null {
+  if (!Array.isArray(path) || path.length === 0) return null;
+  const out: CollabUndoCellStep[] = [];
+  for (const st of path as Rec[]) {
+    if (!st || typeof st !== 'object') return null;
+    const control = st.controlIndex ?? st.controlIdx;
+    const cell = st.cellIndex ?? st.cellIdx;
+    const cellPara = st.cellParaIndex ?? st.cellParaIdx;
+    if (!isNum(control) || !isNum(cell) || !isNum(cellPara) || cell === VIRTUAL_CELL) return null;
+    out.push({ control, cell, cellPara });
+  }
+  return out;
+}
+
+/** 셀 경로의 칸 문단만 새 값으로(키 철자는 그대로). */
+function writeSteps(path: Rec[], steps: readonly CollabUndoCellStep[]): Rec[] {
+  return path.map((st, i) => {
+    const cellPara = steps[i]?.cellPara;
+    if (!isNum(cellPara)) return st;
+    return 'cellParaIdx' in st && !('cellParaIndex' in st) ? { ...st, cellParaIdx: cellPara } : { ...st, cellParaIndex: cellPara };
+  });
+}
+
+/** 위치의 셀 단계(바깥 → 안쪽). */
+const stepsOf = (p: CollabUndoPosition): CollabUndoCellStep[] => p.cellPath ?? (p.cell ? [p.cell] : []);
+
+/** 셀 위치(경로 단계들)를 만든다 — 한 단계면 `cell` 도 채운다. */
+function cellPosition(section: number, para: number, offset: number, steps: CollabUndoCellStep[], bias?: 'before' | 'after'): CollabUndoPosition {
+  return { section, para, offset, bias, cell: steps.length === 1 ? steps[0] : null, cellPath: steps };
+}
+
+/** `DocumentPosition` 하나(필드 `field` 에 든 객체)의 자리. 없으면 `null`(자리를 만들지 않는다). */
+function docPos(owner: Rec, field: string, opts: { caret?: boolean; bias?: 'before' | 'after' } = {}): CollabUndoSlot | null {
+  const pos = owner[field] as Rec | undefined;
+  if (!pos || typeof pos !== 'object') return null;
+  const read = (): CollabUndoPosition | null => {
+    if (!isNum(pos.sectionIndex) || !isNum(pos.charOffset)) return null;
+    const bias = opts.bias;
+    if (pos.parentParaIndex === undefined) {
+      if (!isNum(pos.paragraphIndex) || pos.isTextBox) return null;
+      return { section: pos.sectionIndex, para: pos.paragraphIndex, offset: pos.charOffset, bias };
+    }
+    if (pos.isTextBox || !isNum(pos.parentParaIndex)) return null;
+    // 경로가 있으면 경로가 정본(평면 필드는 바깥 표 기준의 레거시), 없으면 평면 한 단계
+    const steps = Array.isArray(pos.cellPath) && pos.cellPath.length > 0
+      ? readSteps(pos.cellPath)
+      : readSteps([{ controlIndex: pos.controlIndex, cellIndex: pos.cellIndex, cellParaIndex: pos.cellParaIndex }]);
+    return steps ? cellPosition(pos.sectionIndex, pos.parentParaIndex, pos.charOffset, steps, bias) : null;
+  };
+  return {
+    key: pos,
+    field: '',
+    caret: opts.caret,
+    get: read,
+    set(p) {
+      const old = read();
+      pos.charOffset = p.offset;
+      const steps = stepsOf(p);
+      if (steps.length === 0) {
+        pos.paragraphIndex = p.para;
+        return;
+      }
+      const oldSteps = old ? stepsOf(old) : [];
+      const innerOld = oldSteps[oldSteps.length - 1]?.cellPara;
+      const innerNew = steps[steps.length - 1].cellPara;
+      const outerOld = oldSteps[0]?.cellPara;
+      const outerNew = steps[0].cellPara;
+      pos.parentParaIndex = p.para;
+      // 셀 위치의 paragraphIndex 는 (가장 안쪽) 칸 문단 번호다(command.ts cellParagraphPosition)
+      if (pos.paragraphIndex === undefined || pos.paragraphIndex === innerOld) pos.paragraphIndex = innerNew;
+      // 평면 cellParaIndex 는 바깥 표 기준이지만 cellParagraphPosition 은 안쪽 값을 쓴다 — 지금 값이 가리키는 쪽을 따른다
+      if (pos.cellParaIndex !== undefined) {
+        pos.cellParaIndex = pos.cellParaIndex === innerOld ? innerNew : pos.cellParaIndex === outerOld ? outerNew : pos.cellParaIndex;
+      }
+      if (Array.isArray(pos.cellPath) && pos.cellPath.length === steps.length) pos.cellPath = writeSteps(pos.cellPath as Rec[], steps);
+    },
+  };
+}
+
+/** (구역, 문단) 숫자 두 필드. `span` 이 있으면 그 필드도 같은 만큼 민다(조각의 끝 문단). */
+function secPara(owner: Rec, secField: string, paraField: string, span?: string): CollabUndoSlot | null {
+  if (!isNum(owner[secField]) || !isNum(owner[paraField])) return null;
+  return {
+    key: owner,
+    field: paraField,
+    get: () => (isNum(owner[secField]) && isNum(owner[paraField]) ? { section: owner[secField] as number, para: owner[paraField] as number, offset: 0 } : null),
+    set(p) {
+      if (span && isNum(owner[span])) owner[span] = (owner[span] as number) + (p.para - (owner[paraField] as number));
+      owner[paraField] = p.para;
+    },
+  };
+}
+
+/** 구역 번호는 다른 객체가 들고 있고 문단 번호만 `owner[paraField]` 에 있는 자리(z 순서의 이동 목록 등). */
+function paraIn(owner: Rec, paraField: string, section: unknown): CollabUndoSlot | null {
+  if (!isNum(section) || !isNum(owner[paraField])) return null;
+  return {
+    key: owner,
+    field: paraField,
+    get: () => (isNum(owner[paraField]) ? { section, para: owner[paraField] as number, offset: 0 } : null),
+    set(p) { owner[paraField] = p.para; },
+  };
+}
+
+/**
+ * 개체 자리: 개체를 품은 본문 문단 `owner[paraField]`, 셀 안이면 `owner[pathField]`(셀 경로, 마지막 단계의 칸 문단이
+ * 개체를 품은 문단). 개체 번호(`ci`)는 옮기지 않는다 — 같은 문단에 개체를 넣고 빼는 편집은 구조 편집이라 막힌다.
+ */
+function objectAt(owner: Rec, secField: string, paraField: string, pathField?: string): CollabUndoSlot | null {
+  const path = pathField ? owner[pathField] : undefined;
+  if (!Array.isArray(path) || path.length === 0) return secPara(owner, secField, paraField);
+  return {
+    key: owner,
+    field: paraField,
+    get() {
+      const sec = owner[secField];
+      const para = owner[paraField];
+      const steps = readSteps(owner[pathField!]);
+      return isNum(sec) && isNum(para) && steps ? cellPosition(sec, para, 0, steps) : null;
+    },
+    set(p) {
+      owner[paraField] = p.para;
+      const cur = owner[pathField!];
+      const steps = stepsOf(p);
+      if (Array.isArray(cur) && cur.length === steps.length) owner[pathField!] = writeSteps(cur as Rec[], steps);
+    },
+  };
+}
+
+/** ApplyCharFormat 의 문단별 기록(`paraIndex` 또는 셀이면 `cellPathJson` 의 칸 문단). */
+function charFormatEntries(cmd: Rec): CollabUndoSlot[] {
+  const start = cmd.start as Rec | undefined;
+  const entries = (cmd.entries as Rec[] | undefined) ?? [];
+  if (!start) return [];
+  return entries.map((entry) => ({
+    key: entry,
+    field: 'para',
+    get() {
+      if (!isNum(start.sectionIndex)) return null;
+      if (typeof entry.cellPathJson !== 'string') {
+        return isNum(entry.paraIndex) ? { section: start.sectionIndex, para: entry.paraIndex, offset: 0 } : null;
+      }
+      let path: unknown;
+      try { path = JSON.parse(entry.cellPathJson); } catch { return null; }
+      const steps = readSteps(path);
+      if (!steps || !isNum(start.parentParaIndex)) return null;
+      // 표를 품은 문단은 start 가 들고 있다(같은 지도로 따로 옮겨진다) — 여기선 칸 문단만
+      return cellPosition(start.sectionIndex, start.parentParaIndex, 0, steps);
+    },
+    set(p) {
+      if (typeof entry.cellPathJson !== 'string') {
+        entry.paraIndex = p.para;
+        return;
+      }
+      const path = JSON.parse(entry.cellPathJson) as Rec[];
+      const steps = stepsOf(p);
+      const innerOld = (path[path.length - 1] as Partial<CellEntry>).cellParaIndex;
+      entry.cellPathJson = JSON.stringify(writeSteps(path, steps));
+      if (isNum(entry.paraIndex) && entry.paraIndex === innerOld) entry.paraIndex = steps[steps.length - 1]?.cellPara ?? entry.paraIndex;
+    },
+  }));
+}
+
+/** ApplyParaFormat 의 대상(본문 문단 / 셀 문단 / 셀 경로). 같은 대상 객체를 history 기록도 가리킨다. */
+function paraTargets(cmd: Rec): CollabUndoSlot[] {
+  const targets = (cmd.targets as Rec[] | undefined) ?? [];
+  return targets.map((t) => ({
+    key: t,
+    field: 'target',
+    get() {
+      if (!isNum(t.sec)) return null;
+      if (t.kind === 'body') return isNum(t.para) ? { section: t.sec, para: t.para, offset: 0 } : null;
+      if (!isNum(t.parentPara)) return null;
+      const steps = t.kind === 'cell'
