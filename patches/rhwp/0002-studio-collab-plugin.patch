--- /dev/null
+++ b/rhwp-studio/src/core/font-policy.ts
@@ -0,0 +1,39 @@
+/**
+ * cc-rhwp(S3-1): 글꼴 정책 — 공동편집 중 기기·브라우저가 달라도 같은 조판이 나오게 한다.
+ *
+ * `bundled-only` 를 누가 쥐고 있는 동안:
+ * - **조판**은 엔진 내장 규칙(기본 글꼴 환경)만 쓴다. 선언 글꼴 환경(로컬·`local()` 존재 확인·내장 웹 글꼴
+ *   프로그램 메트릭), Canvas 보충 측정(`measureText`), 네이티브 OTF/PUA 공급, 호스트 글꼴은 조판에 들어가지
+ *   않는다. Node(서버 정본·시뮬레이션)와 같은 환경이다.
+ * - **표시**는 내장 웹 글꼴만 쓴다(로컬 글꼴 스냅샷 적재·권한 안내·CanvasKit 로컬 face 준비를 건너뛴다).
+ *
+ * 여러 곳이 쥘 수 있고, 마지막 해제 때 원래 동작으로 돌아간다. 바뀔 때마다 구독자에게 알린다.
+ */
+const holders = new Set<symbol>();
+const listeners = new Set<() => void>();
+
+export function bundledFontsOnly(): boolean {
+  return holders.size > 0;
+}
+
+/** 정책을 쥔다. 반환값은 해제 함수(여러 번 불러도 안전). */
+export function acquireBundledFontPolicy(owner = 'anonymous'): () => void {
+  const token = Symbol(owner);
+  const before = bundledFontsOnly();
+  holders.add(token);
+  if (!before) notify();
+  return () => {
+    if (holders.delete(token) && !bundledFontsOnly()) notify();
+  };
+}
+
+export function onFontPolicyChanged(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => { listeners.delete(listener); };
+}
+
+function notify(): void {
+  for (const listener of [...listeners]) {
+    try { listener(); } catch (error) { console.warn('[FontPolicy] 구독자 오류', error); }
+  }
+}
