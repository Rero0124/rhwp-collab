+  MergeParagraphCommand: ['position'],
+  MergeNextParagraphCommand: ['position'],
+  SplitParagraphInCellCommand: ['position'],
+  MergeParagraphInCellCommand: ['position'],
+  MergeNextParagraphInCellCommand: ['position'],
+  FragmentDeleteCommand: ['cursorBefore', 'cursorAfter', 'sectionIdx', 'startPara', 'endPara'],
+  DeleteSelectionCommand: ['fragment', 'snapshot', 'selection'],
+  ApplyCharFormatCommand: ['start', 'end', 'entries'],
+  ApplyParaFormatCommand: ['targets', 'cursorBefore'],
