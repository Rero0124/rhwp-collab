+
+const compact = (slots: Array<CollabUndoSlot | null>): CollabUndoSlot[] => slots.filter((s): s is CollabUndoSlot => s !== null);
+
+/** 위치 하나만 들고 있는 글자·문단 명령 */
+const POSITION_ONLY = new Set([
+  'insertLineBreak', 'insertTab', 'splitParagraph', 'mergeParagraph', 'mergeNextParagraph',
+  'splitParagraphInCell', 'mergeParagraphInCell', 'mergeNextParagraphInCell',
+]);
