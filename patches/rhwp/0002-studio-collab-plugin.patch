+// ── 공동편집 이탈 확인·여는 주소 (cc-rhwp) ─────────────────────────────────────
+
+test('이탈 확인: 판정을 걸면 저장 안 한 변경 대신 그 판정으로 묻고, 풀면 원래대로', async () => {
+  const { DocumentDirtyState } = await import('../src/core/document-dirty-state.ts');
+  const state = new DocumentDirtyState({ emit() {} } as never);
+  const listeners: Array<(e: { preventDefault(): void; returnValue: unknown }) => unknown> = [];
+  state.installBeforeUnload({ addEventListener: (_: string, fn: never) => listeners.push(fn), removeEventListener() {} } as never);
+  const asks = () => {
+    let prevented = false;
+    listeners[0]({ preventDefault() { prevented = true; }, returnValue: undefined });
+    return prevented;
+  };
+  state.markDirty();
+  assert.equal(asks(), true, '기본: 저장 안 한 변경이면 묻는다');
+  let unsent = false;
+  const release = state.guardUnload(() => unsent);
+  assert.equal(asks(), false, '공동편집: 저장 안 한 변경이 있어도 보내지 못한 편집이 없으면 묻지 않는다');
+  unsent = true;
+  assert.equal(asks(), true, '보내지 못한 편집이 있으면 묻는다');
+  release();
+  unsent = false;
+  assert.equal(asks(), true, '풀면 다시 저장 안 한 변경으로');
+});
+
+test('guardUnload: 호스트로 넘기고 원장이 unload 때 회수한다(지원하지 않으면 아무 일도 없음)', async () => {
+  const log: string[] = [];
+  const h = hostWith(undefined, {
+    guardUnload: (id, check) => {
+      log.push(`guard ${id} ${check()}`);
+      return () => { log.push('unguard'); };
+    },
+  });
+  await h.registry.load('probe');
+  h.host().guardUnload(() => true);
+  await h.registry.unload('probe');
+  assert.deepEqual(log, ['guard probe true', 'unguard']);
+});
