diff --git a/rhwp-studio/src/plugin/document-intercept.ts b/rhwp-studio/src/plugin/document-intercept.ts
new file mode 100644
index 00000000..011add1c
--- /dev/null
+++ b/rhwp-studio/src/plugin/document-intercept.ts
@@ -0,0 +1,59 @@
+/**
+ * cc-rhwp: 문서 객체 메서드 가로채기 — `PluginHost.interceptDocumentCalls` 의 구현.
+ *
+ * 플러그인에 wasm 모듈을 주지 않는다는 계약(`types.ts` 의 `PluginHost` 주석)을 지키면서, 문서를 바꾸는
+ * 호출 앞뒤에 플러그인이 끼어들 공식 자리다(공동편집의 기록 훅). studio 가 `HwpDocument.prototype` 의
+ * 지정 메서드를 감싸고, 감싼 메서드는 `call(name, args, invoke)` 를 부른다. 플러그인이 `invoke()` 로
+ * 원래 메서드를 실행하므로 전후 처리를 플러그인이 쥔다. 모든 문서 인스턴스에 적용된다.
+ *
+ * 여러 번 감쌀 수 있다. 해제는 자기 감싸개만 걷는다 — 위에 다른 감싸개가 올라와 있으면 자기 것을
+ * 통과 상태로 바꿔 사슬을 끊지 않는다.
+ */
+
+/**
+ * `target` 은 호출된 문서 객체다. 훅은 prototype 에 걸리므로 모든 문서 객체의 호출이 들어온다 — studio 가
+ * 문서를 열면서 교체 전에 새 객체에 보내는 호출, hwpctl 독립 실행의 별도 객체 등. 공유 문서만 기록하려면
+ * 플러그인이 `target` 을 지금 빌린 핸들과 비교한다.
+ */
+export type DocumentCallInterceptor = (name: string, args: unknown[], invoke: () => unknown, target: unknown) => unknown;
+
+interface Wrapper {
+  (this: unknown, ...args: unknown[]): unknown;
+  __ccRhwpPassThrough?: boolean;
+}
+
+/**
+ * `proto` 의 `methods` 중 함수인 것을 감싼다. 반환값은 해제 함수(여러 번 불러도 안전).
+ * 함수가 아닌 이름은 건너뛴다(studio 합성 메서드처럼 문서 객체에 없는 이름).
+ */
+export function interceptPrototype(
+  proto: object,
+  methods: Iterable<string>,
+  call: DocumentCallInterceptor,
+): { release: () => void; wrapped: string[] } {
+  const target = proto as Record<string, unknown>;
+  const installed: Array<{ name: string; previous: unknown; wrapper: Wrapper }> = [];
+  for (const name of new Set(methods)) {
+    const previous = target[name];
+    if (typeof previous !== 'function') continue;
+    const original = previous as (...args: unknown[]) => unknown;
+    const wrapper: Wrapper = function (this: unknown, ...args: unknown[]): unknown {
+      if (wrapper.__ccRhwpPassThrough) return original.apply(this, args);
+      return call(name, args, () => original.apply(this, args), this);
+    };
+    target[name] = wrapper;
+    installed.push({ name, previous, wrapper });
+  }
+  let released = false;
+  return {
+    wrapped: installed.map((i) => i.name),
+    release: () => {
+      if (released) return;
+      released = true;
+      for (const { name, previous, wrapper } of installed.reverse()) {
+        if (target[name] === wrapper) target[name] = previous;
+        else wrapper.__ccRhwpPassThrough = true;
+      }
+    },
+  };
+}
