+    }
+    // ── U2: 개체 ──
+    case 'moveTable': {
+      // 옮긴 뒤 표가 다른 문단으로 갈 수 있다(resultPpi) — 되돌리기는 그 자리, 다시 하기는 원래 자리를 쓴다
+      const from = secPara(cmd, 'sec', 'ppi');
+      const to = secPara(cmd, 'sec', 'resultPpi');
+      return from && to ? { slots: [from, to], store: 'none' } : null;
+    }
+    case 'movePicture':
+    case 'moveShape':
+      return single(objectAt(cmd, 'sec', 'ppi', 'cellPath'));
+    case 'resizeObject': {
+      const targets = (cmd.targets as Rec[] | undefined) ?? [];
+      const slots = targets.map((t) => objectAt(t, 'sec', 'ppi', 'cellPath'));
+      return slots.length > 0 && slots.every((s) => s) ? { slots: compact(slots), store: 'none' } : null;
+    }
+    case 'moveLineEndpoint':
+      return single(secPara(cmd, 'sec', 'ppi'));
+    case 'setObjectProps': {
+      const ref = cmd.ref as Rec | undefined;
+      if (!ref) return null;
+      // 머리말·꼬리말 안 그림: 본문 자리는 머리말 개체를 품은 문단(outerParaIdx). ref.ppi 는 머리말 안 문단이다.
+      const hf = ref.headerFooter as Rec | undefined;
+      return single(hf ? paraIn(hf, 'outerParaIdx', ref.sec) : objectAt(ref, 'sec', 'ppi', 'cellPath'));
+    }
+    // ── U2: 구역 원본 저널 ──
+    case 'changeZOrder': {
+      const moves = (cmd.moves as Rec[] | null | undefined) ?? [];
+      const slots = [secPara(cmd, 'sectionIdx', 'ppi'), ...moves.map((m) => paraIn(m, 'ppi', cmd.sectionIdx)), docPos(cmd, 'cursorPos', { caret: true })];
+      return isNum(cmd.sectionIdx) ? { slots: compact(slots), store: 'section', sections: [cmd.sectionIdx] } : null;
+    }
+    case 'setSectionProps': {
+      // SetSectionPropsCommand(sectionIdx)와 SetSectionPropsAllCommand(sections[].idx)가 같은 type 을 쓴다 — 모양으로 가른다
+      const sections = Array.isArray(cmd.sections) ? (cmd.sections as Rec[]).map((s) => s?.idx) : [cmd.sectionIdx];
+      return sections.length > 0 && sections.every(isNum)
+        ? { slots: compact([docPos(cmd, 'cursorPos', { caret: true })]), store: 'section', sections: sections as number[] }
+        : null;
+    }
+    // ── U2: 양식 ──
+    case 'setFormValue': {
+      const targets = (cmd.targets as Rec[] | undefined) ?? [];
+      const slots = targets.map(formTarget);
+      return slots.length > 0 && slots.every((s) => s)
+        ? { slots: compact([...slots, docPos(cmd, 'pos', { caret: true })]), store: 'none' }
+        : null;
+    }
+    default:
+      return null;
+  }
+}
+
+/** 자리 하나짜리 명령 — 자리를 못 만들면 표 밖(3.2-3). */
+function single(slot: CollabUndoSlot | null): CollabUndoDescriptor | null {
+  return slot ? { slots: [slot], store: 'none' } : null;
+}
+
+function describeFragmentDelete(cmd: Rec): CollabUndoDescriptor {
+  const anchor = secPara(cmd, 'sectionIdx', 'startPara', 'endPara');
+  return {
+    slots: compact([anchor, docPos(cmd, 'cursorBefore', { caret: true }), docPos(cmd, 'cursorAfter', { caret: true })]),
+    store: 'fragment',
+    fragmentAnchor: anchor ?? undefined,
+  };
+}
