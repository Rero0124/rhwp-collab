+  assert.deepEqual(h.log, ['intercept probe insertText all=true']);
+  release();
+  await h.registry.unload('probe');
+  assert.deepEqual(h.log.filter((l) => l === 'intercept-release'), ['intercept-release'], '수동 해제 뒤 회수는 다시 부르지 않는다');
+
+  const h2 = harness();
