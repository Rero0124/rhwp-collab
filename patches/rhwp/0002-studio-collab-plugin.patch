+test('CommandHistory: 기록 중지 동안 execute·recordWithoutExecute 는 쌓지 않고 discard, 멈출 때 비운다', () => {
+  const history = source('src/engine/history.ts');
+  assert.match(history, /setSuspended\(on: boolean, wasm\?: WasmBridge\): void \{\s*if \(on && !this\.suspended\) this\.clear\(wasm\);/);
+  const execute = history.slice(history.indexOf('execute(command: EditCommand'), history.indexOf('// 직전 명령과 병합 시도'));
+  assert.match(execute, /if \(this\.suspended\) \{\s*command\.discard\?\.\(wasm\);\s*return cursorAfter;/);
+  const record = history.slice(history.indexOf('recordWithoutExecute('), history.indexOf('canUndo()'));
