index 00000000..5052f728
--- /dev/null
+++ b/rhwp-studio/tests/plugin-autosave-suspend.test.ts
@@ -0,0 +1,76 @@
+// cc-rhwp: PluginHost.suspendAutosave 의 원장 회수 계약 (docs/collab-design.md §6.9, T8).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { PluginHostRegistry, type PluginHostDeps } from '../src/plugin/host.ts';
+import { PLUGIN_API_VERSION, type PluginHost, type StudioPlugin } from '../src/plugin/types.ts';
+
+function setup(capture: (host: PluginHost) => void, withSuspend = true) {
+  const active = new Set<string>();
+  const calls: string[] = [];
+  const plugin: StudioPlugin = {
+    id: 'probe',
+    apiVersion: PLUGIN_API_VERSION,
+    activate(host) { capture(host); return {}; },
+  };
+  const deps = {
+    wasm: { borrowDocumentHandle: () => null, documentGeneration: 1 },
+    automation: { removeMenuItem: () => {}, unregisterCommand: () => {} },
+    eventBus: { on: () => () => {} },
+    getInputHandler: () => null,
+    loadDocument: async () => {},
+    createBlankDocument: async () => true,
+    resolve: async () => plugin,
+    suspendAutosave: withSuspend
+      ? (pluginId: string) => {
+        const token = `${pluginId}#${calls.length}`;
+        calls.push(token);
+        active.add(token);
+        return () => { active.delete(token); };
+      }
+      : undefined,
+  } as unknown as PluginHostDeps;
+  return { registry: new PluginHostRegistry(deps), active, calls };
+}
+
+test('suspendAutosave 는 플러그인 id 로 중지를 걸고, 재개 함수는 여러 번 불러도 한 번만 푼다', async () => {
+  let host!: PluginHost;
+  const { registry, active, calls } = setup((h) => { host = h; });
+  await registry.load('probe');
+  const resume = host.suspendAutosave();
+  assert.deepEqual(calls, ['probe#0']);
+  assert.equal(active.size, 1);
+  resume();
+  resume();
+  assert.equal(active.size, 0);
+  await registry.unload('probe');
+  assert.equal(active.size, 0, 'unload 가 이미 푼 중지를 다시 건드리지 않는다');
+});
+
+test('unload 는 풀지 않은 중지를 원장에서 회수한다', async () => {
+  let host!: PluginHost;
+  const { registry, active } = setup((h) => { host = h; });
+  await registry.load('probe');
+  host.suspendAutosave();
+  host.suspendAutosave();
+  assert.equal(active.size, 2);
+  await registry.unload('probe');
+  assert.equal(active.size, 0, '자동 저장 재개');
+});
+
+test('활성화 중 건 중지도 회수된다 (활성화 직후 호출 패턴)', async () => {
+  const { registry, active } = setup((h) => { h.suspendAutosave(); });
+  await registry.load('probe');
+  assert.equal(active.size, 1);
+  await registry.unload('probe');
+  assert.equal(active.size, 0);
+});
+
+test('호스트가 중지를 지원하지 않으면 아무 일도 하지 않는 재개 함수를 준다', async () => {
+  let host!: PluginHost;
+  const { registry } = setup((h) => { host = h; }, false);
+  await registry.load('probe');
+  const resume = host.suspendAutosave();
+  assert.doesNotThrow(() => resume());
+  await registry.unload('probe');
+});
