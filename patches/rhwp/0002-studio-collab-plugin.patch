+test('히스토리: 경계마다 훅에 알리고, undo/redo 전에 막힘을 묻고 막히면 문서를 건드리지 않고 버린다', () => {
+  const h = source('src/engine/history.ts');
+  const execute = balancedFrom(h, 'execute(command: EditCommand, wasm: WasmBridge): DocumentPosition', '{');
+  assert.match(execute, /isNoOp\?\.\(\)\) \{[\s\S]*?this\.collab\?\.settled\(\);/);
+  assert.match(execute, /this\.undoStack\[this\.undoStack\.length - 1\] = merged;[\s\S]*?this\.collab\?\.recorded\(merged, last\);/);
+  assert.match(execute, /this\.undoStack\.push\(command\);[\s\S]*?this\.collab\?\.recorded\(command, null\);/);
+  const record = balancedFrom(h, 'recordWithoutExecute(command: EditCommand, wasm?: WasmBridge): void', '{');
+  assert.match(record, /this\.collab\?\.recorded\(merged, last\);/);
+  assert.match(record, /this\.collab\?\.recorded\(command, null\);/);
+  const undo = balancedFrom(h, 'undo(wasm: WasmBridge): DocumentPosition | null', '{');
+  const blocked = undo.indexOf("this.collab?.blocked(command, 'undo')");
+  assert.ok(blocked > 0 && blocked < undo.indexOf('command.undo(wasm)'), 'undo: 막힘 판정이 실행보다 먼저');
+  assert.match(undo, /if \(blocked !== null\) \{\s*this\.undoStack\.pop\(\);\s*command\.discard\?\.\(wasm\);\s*this\.collab\?\.rejected\(command, 'undo', blocked\);\s*return null;/);
+  assert.match(undo, /this\.redoStack\.push\(command\);\s*this\.collab\?\.undone\(command\);/);
+  const redo = balancedFrom(h, 'redo(wasm: WasmBridge): DocumentPosition | null', '{');
+  const rb = redo.indexOf("this.collab?.blocked(command, 'redo')");
+  assert.ok(rb > 0 && rb < redo.indexOf('command.execute(wasm)'), 'redo: 막힘 판정이 실행보다 먼저');
+  assert.match(redo, /this\.undoStack\.push\(command\);\s*this\.collab\?\.redone\(command\);\s*return cursorAfter;/);
+  // 훅을 걸 때 기록 중지를 풀고 스택을 비운다
+  assert.match(h, /setCollabHook\(hook: CollabHistoryHook \| null, wasm\?: WasmBridge\): void \{\s*this\.clear\(wasm\);\s*this\.collab = hook;\s*if \(hook\) this\.suspended = false;/);
+});
