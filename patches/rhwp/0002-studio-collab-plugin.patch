+test('표 대조: 명령이 들고 있는 대상·참조 타입이 표가 읽는 필드를 선언한다', () => {
+  for (const { file, type, fields } of TYPE_FIELDS) {
+    const src = source(file);
+    const at = src.indexOf(`export ${type}`);
+    assert.ok(at >= 0, `${file}: ${type} 이 없음`);
+    const body = balancedFrom(src.slice(at), type, '{');
+    for (const f of fields) assert.match(body, new RegExp(`\\b${f}\\??\\s*:`), `${type}.${f} 선언이 없음`);
+  }
+});
