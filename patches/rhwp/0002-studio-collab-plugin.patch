+// ── 호스트 (실행) ────────────────────────────────────────────────────
+
+function hostWith(enable: PluginHostDeps['enableCollabUndo'] | undefined, extra: Partial<PluginHostDeps> = {}) {
+  let captured: PluginHost | null = null;
+  const plugin: StudioPlugin = { id: 'probe', apiVersion: PLUGIN_API_VERSION, activate(host) { captured = host; return {}; } };
+  const deps = {
+    wasm: { borrowDocumentHandle: () => null, documentGeneration: 1 },
+    automation: { removeMenuItem: () => {}, unregisterCommand: () => {} },
+    eventBus: { on: () => () => {} },
+    getInputHandler: () => null,
+    loadDocument: async () => {},
+    createBlankDocument: async () => true,
+    resolve: async () => plugin,
+    ...(enable ? { enableCollabUndo: enable } : {}),
+    ...extra,
+  } as unknown as PluginHostDeps;
+  return { registry: new PluginHostRegistry(deps), host: () => captured! };
+}
+
+const fakeHook: CollabHistoryHook = { recorded() {}, settled() {}, blocked: () => null, rejected() {}, undone() {}, redone() {} };
+
+test('enableCollabUndo: 호스트로 넘기고 조작을 돌려주며, release 는 원장이 unload 때 한 번 회수한다', async () => {
+  const log: string[] = [];
+  const h = hostWith((id, hook) => {
+    log.push(`enable ${id} ${hook === fakeHook}`);
+    return {
+      controller: { stacks: () => ({ undo: [], redo: [] }), remove: () => {}, clear: () => log.push('clear'), describe: () => null },
+      release: () => log.push('release'),
+    };
+  });
+  await h.registry.load('probe');
+  const ctl = h.host().enableCollabUndo(fakeHook)!;
+  assert.ok(ctl);
+  ctl.clear();
+  assert.deepEqual(log, ['enable probe true', 'clear']);
+  await h.registry.unload('probe');
+  assert.deepEqual(log, ['enable probe true', 'clear', 'release']);
+  ctl.release();
+  assert.equal(log.filter((l) => l === 'release').length, 1);
+});
+
+test('enableCollabUndo: 호스트가 지원하지 않으면 null(플러그인은 suspendHistory 로 돌아간다)', async () => {
