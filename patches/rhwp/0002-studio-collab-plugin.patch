+import { interceptPrototype } from '../src/plugin/document-intercept.ts';
+import { PLUGIN_API_VERSION, type PluginHost, type StudioPlugin } from '../src/plugin/types.ts';
+import { codeOnly } from './support/source-guard.ts';
+
+const rootDir = dirname(dirname(fileURLToPath(import.meta.url)));
+const source = (rel: string): string => codeOnly(readFileSync(join(rootDir, rel), 'utf8'));
