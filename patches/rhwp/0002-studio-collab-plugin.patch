+  assert.match(ih, /canUndo\(\): boolean \{ return this\.historySuspendedMessage !== null \|\| this\.history\.canUndo\(\); \}/);
+  assert.match(ih, /_text\.onCompositionEnd\.call\(this\);\s*(?:\/\/[^\n]*\n\s*)?if \(!this\.isComposing\) this\.eventBus\.emit\('composition-end'\);/);
+  const place = ih.slice(ih.indexOf('placeCaret(pos: DocumentPosition): boolean {'));
+  assert.match(place.slice(0, 400), /if \(this\.isComposing\) return false;[\s\S]*this\.cursor\.clearSelection\(\);\s*this\.cursor\.moveTo\(pos\);/);
+  assert.match(ih, /setHistorySuspended\(message: string \| null\): void \{\s*this\.historySuspendedMessage = message;\s*this\.history\.setSuspended\(message !== null, this\.wasm\);/);
+});
