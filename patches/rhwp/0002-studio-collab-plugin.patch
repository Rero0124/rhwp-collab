+// cc-rhwp: 공동편집용 플러그인 API (docs/collab-stage2.md §6, R2).
+// interceptDocumentCalls · applyExternal · suspendHistory · setCaret · isComposing.
+//
+// 엔진 클래스(InputHandler·CommandHistory)는 node 의 strip-only TS 로 실행할 수 없어(이 저장소의 undo
+// 테스트 관례) 그쪽 배선은 소스 가드로, 호스트·가로채기는 실행으로 검증한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { PluginHostRegistry, HISTORY_SUSPENDED_MESSAGE, type PluginHostDeps } from '../src/plugin/host.ts';
+import { interceptPrototype } from '../src/plugin/document-intercept.ts';
+import { PLUGIN_API_VERSION, type PluginHost, type StudioPlugin } from '../src/plugin/types.ts';
+import { codeOnly } from './support/source-guard.ts';
+
+const rootDir = dirname(dirname(fileURLToPath(import.meta.url)));
+const source = (rel: string): string => codeOnly(readFileSync(join(rootDir, rel), 'utf8'));
+
+// ── 가로채기 (실행) ────────────────────────────────────────────────────
+
+class FakeDoc {
+  value = 0;
+  add(n: number): number { this.value += n; return this.value; }
+  twice(n: number): number { return this.add(n) + this.add(n); }
+}
+
+test('interceptPrototype: 지정 메서드를 감싸고 invoke 가 원래 메서드를 this 와 함께 실행한다, target 은 호출된 객체', () => {
+  const calls: Array<[string, unknown[]]> = [];
+  const targets: unknown[] = [];
+  const { release, wrapped } = interceptPrototype(FakeDoc.prototype, ['add', 'missing'], (name, args, invoke, target) => {
+    calls.push([name, args]);
+    targets.push(target);
+    return invoke();
+  });
+  assert.deepEqual(wrapped, ['add'], '함수가 아닌 이름은 건너뛴다');
+  const a = new FakeDoc(), b = new FakeDoc();
+  assert.equal(a.add(2), 2);
+  assert.equal(b.add(5), 5, '모든 인스턴스에 적용');
+  assert.deepEqual(calls, [['add', [2]], ['add', [5]]]);
+  assert.equal(targets[0], a, '공유 문서인지 가리도록 호출된 객체를 넘긴다');
+  assert.equal(targets[1], b);
+  release();
+  release();
+  a.add(1);
+  assert.equal(calls.length, 2, '해제 뒤에는 감싸지 않는다');
+  assert.equal(a.value, 3);
+});
+
+test('interceptPrototype: call 이 반환값을 바꾸거나 invoke 를 건너뛸 수 있다, 안쪽 호출도 다시 거친다', () => {
+  const names: string[] = [];
+  const { release } = interceptPrototype(FakeDoc.prototype, ['add', 'twice'], (name, _args, invoke) => {
+    names.push(name);
+    return name === 'add' ? (invoke() as number) * 10 : invoke();
+  });
+  const d = new FakeDoc();
+  assert.equal(d.twice(1), 10 + 20);
+  assert.deepEqual(names, ['twice', 'add', 'add']);
+  release();
+});
+
+test('interceptPrototype: 두 겹으로 감싼 뒤 안쪽을 먼저 풀어도 바깥은 그대로 동작한다', () => {
+  const log: string[] = [];
+  const inner = interceptPrototype(FakeDoc.prototype, ['add'], (_n, _a, invoke) => { log.push('inner'); return invoke(); });
+  const outer = interceptPrototype(FakeDoc.prototype, ['add'], (_n, _a, invoke) => { log.push('outer'); return invoke(); });
+  const d = new FakeDoc();
+  d.add(1);
+  assert.deepEqual(log, ['outer', 'inner']);
+  inner.release(); // 위에 outer 가 있으므로 통과 상태가 된다
+  log.length = 0;
+  d.add(1);
+  assert.deepEqual(log, ['outer']);
+  outer.release();
+  log.length = 0;
+  assert.equal(d.add(1), 3);
+  assert.deepEqual(log, []);
+  assert.equal(Object.prototype.hasOwnProperty.call(FakeDoc.prototype, 'add'), true);
+});
+
+// ── 호스트 facade (실행) ───────────────────────────────────────────────
+
+interface Harness {
+  registry: PluginHostRegistry;
+  host: () => PluginHost;
+  log: string[];
+  ih: Record<string, unknown> | null;
+}
+
+/** 노드에는 DOM 이 없다 — 겹침 층 시험에 필요한 만큼만 흉내 낸다. */
+interface FakeEl { name: string; dataset: Record<string, string>; style: { cssText: string }; parentElement: FakeEl | null; children: FakeEl[]; appendChild(c: FakeEl): FakeEl; remove(): void }
+function fakeElement(name = 'div'): FakeEl {
+  const el: FakeEl = {
+    name, dataset: {}, style: { cssText: '' }, parentElement: null, children: [],
+    appendChild(c) { c.parentElement?.children.splice(c.parentElement.children.indexOf(c), 1); c.parentElement = el; el.children.push(c); return c; },
+    remove() { if (el.parentElement) { el.parentElement.children.splice(el.parentElement.children.indexOf(el), 1); el.parentElement = null; } },
+  };
+  return el;
+}
+(globalThis as { document?: unknown }).document ??= { createElement: () => fakeElement() };
+
+function harness(opts: { ih?: boolean; withHooks?: boolean; composing?: boolean } = {}): Harness {
+  const log: string[] = [];
+  let captured!: PluginHost;
+  const doc = { id: 'doc' };
+  const ih = opts.ih === false ? null : {
+    triggerAfterEdit: () => log.push('afterEdit'),
+    executeOperation: () => log.push('executeOperation'),
+    placeCaret: (pos: unknown) => { log.push(`placeCaret ${JSON.stringify(pos)}`); return true; },
+    isImeComposing: () => opts.composing === true,
+    caretRectFor: (pos: unknown) => { log.push(`caretRectFor ${JSON.stringify(pos)}`); return { left: 10, top: 20, height: 16 }; },
+    pluginOverlayLayer: () => sharedLayer,
+  };
+  const sharedLayer = fakeElement('shared');
+  const plugin: StudioPlugin = {
+    id: 'probe',
+    apiVersion: PLUGIN_API_VERSION,
+    activate(host) { captured = host; return {}; },
+  };
+  const deps = {
+    wasm: {
+      borrowDocumentHandle: () => doc,
+      documentGeneration: 1,
+      getSectionCount: () => 2,
+      getParagraphCount: (sec: number) => (sec === 0 ? 3 : 1),
+      getLogicalLength: (_s: number, p: number) => [5, 0, 7][p] ?? 0,
+      getCellParagraphCount: () => 2,
+      getCellParagraphLength: () => 4,
+    },
+    automation: { removeMenuItem: () => {}, unregisterCommand: () => {} },
+    eventBus: { on: (name: string) => { log.push(`on ${name}`); return () => log.push(`off ${name}`); } },
+    getInputHandler: () => ih,
+    loadDocument: async () => {},
+    createBlankDocument: async () => true,
+    resolve: async () => plugin,
+    ...(opts.withHooks === false ? {} : {
+      interceptDocumentCalls: (id: string, methods: readonly string[], all: boolean) => {
+        log.push(`intercept ${id} ${methods.join(',')} all=${all}`);
+        return () => log.push('intercept-release');
+      },
+      suspendHistory: (id: string, message: string) => {
+        log.push(`suspendHistory ${id} ${message}`);
+        return () => log.push('history-resume');
+      },
+    }),
+  } as unknown as PluginHostDeps;
+  const registry = new PluginHostRegistry(deps);
+  return { registry, host: () => captured, log, ih };
+}
+
+test('interceptDocumentCalls: 호스트로 넘기고, 해제는 원장이 unload 때 회수한다(한 번만)', async () => {
+  const h = harness();
+  await h.registry.load('probe');
+  const release = h.host().interceptDocumentCalls({ methods: ['insertText'], includeMutatingRegistry: true, call: (_n, _a, i) => i() });
+  assert.deepEqual(h.log, ['intercept probe insertText all=true']);
+  release();
+  await h.registry.unload('probe');
+  assert.deepEqual(h.log.filter((l) => l === 'intercept-release'), ['intercept-release'], '수동 해제 뒤 회수는 다시 부르지 않는다');
+
+  const h2 = harness();
+  await h2.registry.load('probe');
+  h2.host().interceptDocumentCalls({ methods: ['a'], call: (_n, _a, i) => i() });
+  await h2.registry.unload('probe');
+  assert.ok(h2.log.includes('intercept-release'), 'unload 가 회수');
+});
+
+test('applyExternal: undo 경로 없이 실행하고 전체 갱신한다, 던져도 갱신, 중첩은 거절', async () => {
+  const h = harness();
+  await h.registry.load('probe');
+  const host = h.host();
+  const got = host.applyExternal('collab:remote', (doc) => { h.log.push(`fn ${(doc as unknown as { id: string }).id}`); return 7; });
+  assert.equal(got, 7);
+  assert.deepEqual(h.log, ['fn doc', 'afterEdit']);
+  assert.ok(!h.log.includes('executeOperation'), 'undo 기록(executeOperation)을 거치지 않는다');
+
+  h.log.length = 0;
+  assert.throws(() => host.applyExternal('x', () => { throw new Error('boom'); }), /boom/);
+  assert.deepEqual(h.log, ['afterEdit'], '던져도 갱신');
+
+  assert.throws(
+    () => host.applyExternal('outer', () => host.applyExternal('inner', () => 1)),
+    (e: Error & { code?: string }) => e.code === 'NESTED_TX',
+  );
+});
+
+test('applyExternal: 입력 처리기가 없으면 DOCUMENT_RELEASED', async () => {
+  const h = harness({ ih: false });
+  await h.registry.load('probe');
+  assert.throws(() => h.host().applyExternal('x', () => 1), (e: Error & { code?: string }) => e.code === 'DOCUMENT_RELEASED');
+});
+
+test('suspendHistory: 기본 안내로 호스트에 걸고, 재개는 멱등이며 unload 가 회수한다', async () => {
+  const h = harness();
+  await h.registry.load('probe');
+  const resume = h.host().suspendHistory();
+  assert.deepEqual(h.log, [`suspendHistory probe ${HISTORY_SUSPENDED_MESSAGE}`]);
+  resume(); resume();
+  await h.registry.unload('probe');
+  assert.equal(h.log.filter((l) => l === 'history-resume').length, 1);
+});
+
+test('호스트가 훅을 주지 않으면 intercept·suspendHistory 는 아무 일도 하지 않는다(기본값 불변)', async () => {
+  const h = harness({ withHooks: false });
+  await h.registry.load('probe');
+  const a = h.host().interceptDocumentCalls({ methods: ['x'], call: (_n, _a, i) => i() });
+  const b = h.host().suspendHistory();
+  assert.doesNotThrow(() => { a(); b(); });
+  await h.registry.unload('probe');
+});
+
+test('setCaret: 범위 밖 값은 가장 가까운 유효 위치로 자르고 선택을 접는 placeCaret 으로 옮긴다', async () => {
+  const h = harness();
